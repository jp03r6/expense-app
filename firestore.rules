rules_version = '2';

// ExpenseSnap: every account can read and write ONLY its own receipts.
// Data lives at users/{uid}/reports, users/{uid}/receipts and
// users/{uid}/receipts/{id}/chunks (photo and PDF pieces).
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
